library(tidyverse)
library(janitor)
library(shiny)
library(shinydashboard)
elephants <- read_csv("data/elephants_data/elephants.csv") %>%
clean_names()
ui <- fluidPage(
selectInput("x",
"Select Elephant Attribute",
choices = c("age",
"height"),
selected = "age"
),
plotOutput("plot",
width = "600px",
height = "500px")
)
server <- function(input, output, session) {
}
shinyApp(ui, server)
ui <- fluidPage(
selectInput("y",
"Select Elephant Attribute",
choices = c("age",
"height"),
selected = "age"
),
plotOutput("plot",
width = "600px",
height = "500px")
)
server <- function(input, output, session) {
output$plot <- renderPlot({
elephants %>%
ggplot(
mapping = aes(
y = .data[[input$y]],
x = sex
)
)
})
}
shinyApp(ui, server)
