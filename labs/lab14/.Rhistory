server <- function(input, output, session) {
output$plot <- renderPlot({
ggplot(data=penguins,
aes_string(
x = input$x,
y = input$y,
color = penguins$species
)
#new syntax
#aes(x = .data[[input$x]], ...)
)+
geom_point()+
if (input$show_lm)
geom_smooth(method = lm, se = F)
else
NULL
})
}
